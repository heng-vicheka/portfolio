{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
		"lint:cache": "prettier --check . && eslint --cache .",
		"format": "prettier --write .",
		"lint:spell": "cspell \"src/**/*.{js,css,html}\" \"*.config.{js,ts}\" \"README.md\"",
		"precommit": "lefthook run pre-commit",
		"prepush": "lefthook run pre-push",
		"prevent-main-commit": "tsx scripts/prevent-main-commit.ts",
		"update:latest": "pnpm update --latest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.5.0",
		"cspell": "^9.7.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"lefthook": "^2.1.4",
		"prettier": "^3.8.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.57.2",
		"vite": "^8.0.3"
	},
	"pnpm": {
		"overrides": {
			"esbuild": ">=0.25.0",
			"cookie": ">=0.7.0",
			"devalue": ">=5.6.4"
		}
	}
}
