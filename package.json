{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:cache": "prettier --check . && eslint --cache .",
		"lint:prettier": "prettier --check .",
		"lint:spell": "cspell \"src/**/*.{ts,tsx,js,css,html}\" \"*.config.{js,ts}\" \"README.md\"",
		"precommit": "lefthook run pre-commit",
		"prepush": "lefthook run pre-push",
		"prevent-main-commit": "tsx scripts/prevent-main-commit.ts",
		"preview": "vite preview",
		"update:latest": "pnpm update --latest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"cspell": "^10.0.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.5.0",
		"lefthook": "^2.1.6",
		"prettier": "^3.8.3",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.8"
	},
	"pnpm": {
		"overrides": {
			"esbuild": ">=0.25.0",
			"cookie": ">=0.7.0",
			"devalue": ">=5.6.4"
		}
	},
	"dependencies": {
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	}
}
